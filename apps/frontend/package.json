{
  "name": "@mono/frontend",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "frontend for Mono",
  "scripts": {
    "dev": "bunx -b vite",
    "build": "bunx -b vite build",
