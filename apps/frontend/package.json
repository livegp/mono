{
  "name": "@mono/frontend",
  "version": "0.0.1",
  "private": true,
  "description": "frontend for Mono",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx -b vite build",
    "verify:build": "bun --cwd ../.. apps/frontend/scripts/verify-build.ts",
    "check-types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@mono/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@julr/vite-plugin-validate-env": "^2.2.2",
    "@mono/backend": "workspace:*",
    "@mono/config": "workspace:*",
    "@spiriit/vite-plugin-svg-spritemap": "^7.0.1",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/devtools": "^0.4.10",
    "@vitejs/plugin-react": "^6.0.4",
    "svgo": "^4.0.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-imagetools": "^10.0.1",
    "vite-plugin-bun-csp": "^2.1.2",
    "vite-plugin-hashed-favicons": "^2.1.1",
    "vite-plugin-open-graph": "^2.0.6",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-webfont-dl": "^3.12.0"
  }
}
