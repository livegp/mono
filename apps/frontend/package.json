    "react-dom": "catalog:",
    "tailwindcss": "^4.2.1",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@julr/vite-plugin-validate-env": "^2.2.0",
    "@mono/backend": "workspace:*",
    "@mono/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-bun-csp": "^2.1.1",
    "vite-tsconfig-paths": "^6.1.1"
