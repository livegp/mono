    "lint:fix": "bunx ultracite fix",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@mono/ui": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
