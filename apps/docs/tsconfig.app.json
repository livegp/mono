{
  "extends": "@mono/config/ts/react-app",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "stories/**/*.tsx",
    ".storybook/preview.ts",
    ".storybook/vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".turbo"]
}
