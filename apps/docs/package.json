{
  "name": "@mono/docs",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "documentation for Mono",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o dist --docs",
    "check-types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "bunx ultracite check",
    "lint:fix": "bunx ultracite fix",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@mono/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@mono/config": "workspace:*",
    "@storybook/addon-links": "10.2.15",
    "@storybook/addon-docs": "^10.2.15",
    "@storybook/react": "^10.2.15",
    "@storybook/react-vite": "^10.2.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "storybook": "^10.2.15",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
