{
  "name": "@mono/backend",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "backend for Mono",
  "module": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build.ts",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "bun test",
    "lint": "bunx ultracite check",
    "lint:fix": "bunx ultracite fix",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/opentelemetry": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.27"
  },
  "devDependencies": {
    "@mono/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
