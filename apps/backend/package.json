{
  "name": "@mono/backend",
  "version": "0.0.1",
  "private": true,
  "description": "backend for Mono",
  "license": "MIT",
  "type": "module",
  "module": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build.ts",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "bun test",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.29",
    "elysia-helmet": "^3.1.0"
  },
  "devDependencies": {
    "@mono/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
